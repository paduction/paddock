# Copy to tools/deploy.local.env (git-ignored) and fill in. Nothing here is read by the app itself.

# pnpm run deploy — copies the build and the integration to Home Assistant over SSH
# ("Terminal & SSH" app of Home Assistant, with your public key in its settings)
HA_HOST=root@homeassistant.local
HA_PORT=2222
HA_KEY=~/.ssh/id_ed25519

# pnpm discover / pnpm config:check — read-only questions to Home Assistant
# Token: Home Assistant → your profile → Security → Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
