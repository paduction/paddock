{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paddock",
  "version": "0.1.0",
  "identifier": "how.pad.paddock",
  "build": {
    "frontendDist": "../../tablet/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @paddock/tablet dev",
    "beforeBuildCommand": "pnpm --filter @paddock/tablet build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paddock",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "backgroundColor": "#0b0a08"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Home Assistant on your desk",
    "longDescription": "Paddock shows your Home Assistant home in one window: lights, shutters, cameras, music, cinema, energy. Same interface as the Paddock wall tablet.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
